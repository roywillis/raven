# Copy to .env.local and fill in. .env.local is git-ignored: never commit real values.

# ---- Data source -------------------------------------------------------------------------
# "fixture" = bundled fictional sample data (local development), "sheets" = the master Google Sheet.
RAVEN_DATA_SOURCE=fixture

# ---- Google Sheets (required when RAVEN_DATA_SOURCE=sheets) --------------------------------
# The long ID in https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service-account key JSON, as raw JSON on one line or base64-encoded. Share the sheet with the
# service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tab names (defaults shown).
RAVEN_TAB_APPLICATIONS=applications
RAVEN_TAB_REVIEWS=raven_reviews
RAVEN_TAB_USERS=raven_users

# ---- Sign-in ----------------------------------------------------------------------------
# Session signing key, at least 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public base URL of the app (used for OAuth redirects).
NEXTAUTH_URL=http://localhost:3000
# Google OAuth client (Web application) for analyst sign-in. Authorized redirect URI:
#   <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local development only: sign in as a sample user without Google. Refused in production
# and when RAVEN_DATA_SOURCE=sheets.
RAVEN_DEV_SIGNIN=false
