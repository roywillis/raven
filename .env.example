# Copy to .env.local and fill in. .env.local and secrets/ are git-ignored.

# Data source: "fixture" (bundled sample rows, default) or "sheets" (Google Sheets, not yet implemented).
RAVEN_DATA_SOURCE=fixture

# ID of the master Google Sheet (the long ID in https://docs.google.com/spreadsheets/d/<ID>/edit).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab (worksheet) holding the application rows.
GOOGLE_SHEETS_APPLICATIONS_TAB=Applications

# Path to a Google service-account JSON key with edit access to the sheet.
# Required for write-back: Google API keys can only read public sheets, never write.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Optional: API key for read-only access, if the sheet is shared publicly. Not used for writes.
GOOGLE_SHEETS_API_KEY=

# Analyst identity recorded on decisions until authentication is specified.
RAVEN_ANALYST_ID=ANALYST_LOCAL_01
